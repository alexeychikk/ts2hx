{
	"name": "ts2hx",
	"version": "1.0.0",
	"description": "Converts TypeScript into Haxe",
	"keywords": [
		"typescript",
		"haxe",
		"converter",
		"ast"
	],
	"main": "dist/src/cli.js",
	"engines": {
		"npm": ">=11.0.0",
		"node": ">=26"
	},
	"scripts": {
		"start": "node ./dist/src/cli.js",
		"prestart": "npm run ts",
		"clean": "rimraf ./dist/src",
		"prets": "npm run clean",
		"ts": "tsc -p tsconfig.lib.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prettify": "npx prettier --write .",
		"pretest": "tsc -p tsconfig.spec.json",
		"test": "jest",
		"pretest:coverage": "rimraf ./coverage",
		"test:coverage": "npm run test -- --coverage",
		"setup:haxe": "bash scripts/setup-haxe.sh",
		"conformance": "npm run ts && node dist/conformance/run.js"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"commander": "15.1.0",
		"fs-extra": "11.4.1",
		"lodash": "4.18.1",
		"rimraf": "6.1.4",
		"typescript": "6.0.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/fs-extra": "11.0.4",
		"@types/jest": "30.0.0",
		"@types/lodash": "4.17.27",
		"@types/node": "26.6.6",
		"@types/seedrandom": "3.0.8",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"jest": "30.5.2",
		"joi": "18.3.2",
		"nanoid": "5.1.6",
		"prettier": "3.10.1",
		"seedrandom": "3.0.5",
		"ts-jest": "29.4.15",
		"typescript-eslint": "8.72.2"
	}
}
